ACCOUNT_ID=your_aws_account_id
COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_SECRET_ID=pinhaoyun/secret
VIDEOS_DELETE_QUEUE_URL=xxxxxxxxxxxxxxxxxxxxxxxxxx
LOCATION_ENRICH_QUEUE_URL=xxxxxxxxxxxxxxxxxxxxxxxxxx

# S3 buckets for video upload/preview
S3_ORIGINAL_BUCKET=xxxxxxxxxxxxxxxxxxxxxxxxxx
S3_THUMBNAIL_BUCKET=xxxxxxxxxxxxxxxxxxxxxxxxxx
S3_PROFILE_BUCKET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# DynamoDB table for video metadata
VIDEOS_TABLE=xxxxxxxxxxxxxxxxxxxxxxxxxx
TIMELINE_INDEX_NAME=TimelineIndex

# DynamoDB table for user profiles
USERS_TABLE=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cleanup Lambda controls
CLEANUP_PREFIX=video/
CLEANUP_MAX_KEYS=1000
CLEANUP_PAGE_SIZE=250

# Optional: ImageMagick paths for photo ingest Lambda
IMAGEMAGICK_IDENTIFY_PATH=/opt/bin/identify
IMAGEMAGICK_CONVERT_PATH=/opt/bin/convert

# Optional: presigned URL TTL in seconds (default 900)
PRESIGN_TTL_SECONDS=900

# App URL for Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PLUS_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ULTRA_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Mapbox public token for map display
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token

# Optional: server-side Mapbox token for geocoding
MAPBOX_TOKEN=pk.your_mapbox_token
